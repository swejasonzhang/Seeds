# Copy to server/.env for local overrides. Everything is optional for local dev.

# --- core ---
MONGODB_URI=mongodb://localhost:27017/seeds
PORT=5080
PRACTICE_TIME_ZONE=America/New_York
# demo = open staff pages, fictional data only. entra = Microsoft Entra ID sign-in (default in production).
AUTH_MODE=demo
SEED_DEMO_DATA=true

# --- Microsoft Entra ID sign-in ---
# AUTH_MODE=entra → Microsoft only. AUTH_MODE=demo + these set → Microsoft sign-in AND demo accounts (hybrid).
# ENTRA_TENANT_ID: your tenant GUID, or "common" for any work/school + personal Microsoft account.
# API app registration: expose scope "access_as_user"; define app roles Intake.Coordinator, Clinical.Therapist, Practice.Admin
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=api://<api-app-client-id>
ENTRA_API_CLIENT_ID=<api-app-client-id>
# SPA app registration (redirect URI = your site origin), granted the API scope above
ENTRA_SPA_CLIENT_ID=
ENTRA_API_SCOPE=api://<api-app-client-id>/access_as_user
# Optional: sign-in authority override (e.g. https://<tenant>.ciamlogin.com for Entra External ID)
ENTRA_AUTHORITY=
# Demo only: role for Microsoft accounts with no app role and no linked therapist/family (coordinator|admin|therapist)
ENTRA_DEFAULT_ROLE=

# --- Azure Maps: real drive times (Route Matrix) and rooftop geocoding ---
# Either a key, or keyless Entra auth via AZURE_MAPS_CLIENT_ID + a service principal (AZURE_TENANT_ID/AZURE_CLIENT_ID/AZURE_CLIENT_SECRET)
AZURE_MAPS_KEY=
AZURE_MAPS_CLIENT_ID=

# --- Microsoft Graph: push standing sessions to therapists' Outlook calendars ---
GRAPH_CALENDAR_SYNC=false
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# --- Azure Monitor / Application Insights ---
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- tuning ---
INTAKE_RATE_LIMIT_PER_HOUR=20
TRAVEL_AVERAGE_MPH=22
MATCH_MIN_GAP_MINUTES=10
