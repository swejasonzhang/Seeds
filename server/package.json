{
  "name": "@seeds/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --exclude \"../node_modules/**\" --exclude \"./node_modules/**\" src/server.ts",
    "seed": "tsx src/seed/run.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "build": "node build.mjs",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/monitor-opentelemetry": "^1.18.1",
    "@seeds/shared": "*",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jose": "^6.2.15",
    "mongoose": "^9.11.4",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^4.1.12"
  }
}
